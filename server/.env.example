# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=gympilot_db
DB_TIMEZONE=+05:30
# Database TLS/SSL (Default: enabled with TLSv1.2+ for cloud DBs; set DB_SSL=false for local non-TLS MySQL)
DB_SSL=false

# Dual JWT Authentication
JWT_ACCESS_SECRET=gympilot_access_token_super_secret_key_change_in_prod
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_SECRET=gympilot_refresh_token_super_secret_key_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security & Cross-Domain Sessions
COOKIE_SECRET=gympilot_cookie_secret_key_change_in_prod
# Cookie SameSite: 'lax', 'strict', or 'none' (use 'none' for decoupled cross-origin frontend/backend deployments)
COOKIE_SAME_SITE=lax
